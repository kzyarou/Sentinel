# Application
APP_NAME=Sentinel
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# API
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# Database
# For local development with Docker: postgresql+asyncpg://sentinel_user:changeme@localhost:5432/sentinel
# For production: Use environment-specific secure credentials
DATABASE_URL=postgresql+asyncpg://sentinel_user:changeme@localhost:5432/sentinel
