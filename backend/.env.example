# Application
APP_NAME=Sentinel
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# API
API_V1_PREFIX=/api/v1
MAX_PAYLOAD_SIZE=1048576  # 1MB maximum request payload size

# Server
HOST=0.0.0.0
PORT=8000

# Database
# For local development with Docker: postgresql+asyncpg://sentinel_user:your_password_here@localhost:5432/sentinel
# For production: Use environment-specific secure credentials
DATABASE_URL=postgresql+asyncpg://sentinel_user:your_password_here@localhost:5432/sentinel
