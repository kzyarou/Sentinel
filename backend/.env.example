# Application
APP_NAME=Sentinel
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# API
API_V1_PREFIX=/api/v1
MAX_PAYLOAD_SIZE=1048576  # 1MB maximum request payload size

# Server
HOST=0.0.0.0
PORT=8000

# Database
# For Docker development: postgresql+asyncpg://sentinel:sentinel@postgres:5432/sentinel
# For local development without Docker: postgresql+asyncpg://sentinel_user:your_password_here@localhost:5432/sentinel
# For production: Use environment-specific secure credentials
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@postgres:5432/sentinel

# JWT Configuration
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration
# For local development, allow Next.js development server
# For production, specify exact frontend origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
