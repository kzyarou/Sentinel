# Docker Environment Configuration Example
# Copy this file to .env and update with your actual values
# DO NOT commit .env with real credentials to the repository

# PostgreSQL Configuration
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
POSTGRES_DB=sentinel

# Backend Configuration
BACKEND_PORT=8000
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@postgres:5432/sentinel

# JWT Authentication Configuration
SECRET_KEY=change-this-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration
# For local development, allow Next.js development server
# For production, specify exact frontend origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# Frontend Configuration
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# AI Provider Configuration (Optional)
# AI_PROVIDER=openai
# AI_API_KEY=your-api-key-here
# AI_MODEL=gpt-4
# AI_TIMEOUT=30
# AI_MAX_RETRIES=3